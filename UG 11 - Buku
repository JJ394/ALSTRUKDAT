from bs4 import BeautifulSoup
import streamlit as st
import pandas as pd
import json
import matplotlib.pyplot as plt
import requests

RATING_MAP = {
    "One": 1,
    "Two": 2,
    "Three": 3,
    "Four": 4,
    "Five": 5,
}

st.set_page_config(page_title="Dashboard Katalog Buku", layout="wide")
st.title("Dashboard Katalog Buku")
st.write("Mengambil data buku melalui web scraping dan kurs GBP/IDR melalui REST API.")

jumlah_halaman = st.slider("Jumlah halaman katalog yang diambil", 1, 3, 2)

if st.button("Ambil Data dan Tampilkan Dashboard", type="primary"):
    data_buku = []

    for hal in range(1, jumlah_halaman + 1):
        if hal == 1:
            url = "http://books.toscrape.com/index.html"
        else:
            url = f"http://books.toscrape.com/catalogue/page-{hal}.html"

        response = requests.get(url)
        soup = BeautifulSoup(response.text, "html.parser")

        for item in soup.select("article.product_pod"):
            judul_tag = item.select_one("h3 a")
            judul = judul_tag["title"].strip() if judul_tag else ""

            harga_teks = item.select_one("p.price_color").get_text(strip=True)
            harga_bersih = "".join(ch for ch in harga_teks if ch.isdigit() or ch == ".")
            harga_gbp = float(harga_bersih)

            rating_classes = item.select_one("p.star-rating").get("class", [])
            rating_teks = next((c for c in rating_classes if c in RATING_MAP), None)
            rating = RATING_MAP.get(rating_teks, 0)

            ketersediaan = item.select_one("p.instock.availability").get_text(strip=True)

            data_buku.append({
                "judul": judul,
                "harga_gbp": harga_gbp,
                "rating": rating,
                "ketersediaan": ketersediaan,
            })

    df = pd.DataFrame(data_buku)

    api_url = "https://api.frankfurter.dev/v1/latest?from=GBP&to=IDR"
    kurs_response = requests.get(api_url, timeout=10)
    kurs_response.raise_for_status()
    kurs_data = kurs_response.json()
    kurs_gbp_to_idr = float(kurs_data["rates"]["IDR"])

    df["harga_idr"] = df["harga_gbp"] * kurs_gbp_to_idr

    st.subheader("Data Katalog Buku")
    st.caption(f"**{len(df)}** buku diambil dari **{jumlah_halaman}** halaman")
    st.dataframe(df, use_container_width=True)

    st.subheader("Visualisasi")
    col1, col2 = st.columns(2)

    with col1:
        fig1, ax1 = plt.subplots()
        ax1.hist(df["harga_idr"], bins=10, edgecolor="black")
        ax1.set_title("Distribusi Harga Buku")
        ax1.set_xlabel("Harga (Rupiah)")
        ax1.set_ylabel("Jumlah Buku")
        ax1.grid(axis="y", alpha=0.3)
        st.pyplot(fig1)

    with col2:
        rating_counts = df["rating"].value_counts().reindex([1, 2, 3, 4, 5], fill_value=0)
        fig2, ax2 = plt.subplots()
        ax2.bar(rating_counts.index, rating_counts.values)
        ax2.set_title("Jumlah Buku Berdasarkan Rating")
        ax2.set_xlabel("Rating")
        ax2.set_ylabel("Jumlah Buku")
        ax2.grid(axis="y", alpha=0.3)
        st.pyplot(fig2)
    
    
